<UserControl x:Class="Lumen.Controls.StatusRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Lumen.Controls">
  <!-- Low telemetry rail. Four cells; wraps to 2×2 on narrow layouts. -->
  <Grid x:Name="RailGrid" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="{StaticResource HairlineTop}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="SolarCell" Padding="32,20" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:TelemetryReadout x:Name="SolarReadout" Label="SOLAR INPUT" />
      <controls:Sparkline x:Name="SolarSpark" Grid.Column="1" VerticalAlignment="Bottom" MaxWidth="160" />
    </Grid>
    <Grid x:Name="BatteryCell" Grid.Column="1" Padding="32,20" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="{StaticResource HairlineLeft}">
      <controls:TelemetryReadout x:Name="BatteryReadout" Label="BATTERY" />
    </Grid>
    <Grid x:Name="LoadCell" Grid.Column="2" Padding="32,20" ColumnSpacing="16" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="{StaticResource HairlineLeft}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:TelemetryReadout x:Name="LoadReadout" Label="SYSTEM LOAD" />
      <controls:Sparkline x:Name="LoadSpark" Grid.Column="1" VerticalAlignment="Bottom" MaxWidth="160" />
    </Grid>
    <Grid x:Name="ThermalCell" Grid.Column="3" Padding="32,20" ColumnSpacing="16" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="{StaticResource HairlineLeft}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:TelemetryReadout x:Name="ThermalReadout" Label="THERMAL" />
      <controls:Sparkline x:Name="ThermalSpark" Grid.Column="1" VerticalAlignment="Bottom" MaxWidth="160" />
    </Grid>
  </Grid>
</UserControl>
