<UserControl x:Class="Lumen.Presentation.Energy.EnergyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Lumen.Controls">
  <StackPanel>
    <StackPanel Padding="{StaticResource SectionPadding}" Spacing="24">
      <TextBlock Text="ENERGY FLOW" Style="{StaticResource SectionHeaderStyle}" />
      <TextBlock Style="{StaticResource BodyTextStyle}"
                 Text="Solar feeds the Core; the Core feeds the system and exchanges with the battery. Particle speed is rate, density is volume, direction is transfer." />
      <Grid ColumnSpacing="24" RowSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:TelemetryReadout Label="SOLAR IN" Value="{x:Bind ViewModel.SolarText, Mode=OneWay}" />
        <controls:TelemetryReadout Grid.Column="1" Label="SYSTEM OUT" Value="{x:Bind ViewModel.LoadText, Mode=OneWay}" />
        <controls:TelemetryReadout Grid.Row="1" Label="BATTERY" Value="{x:Bind ViewModel.BatteryText, Mode=OneWay}"
                                   BarValue="{x:Bind ViewModel.BatteryFraction, Mode=OneWay}" />
        <controls:TelemetryReadout Grid.Row="1" Grid.Column="1" Label="NET" Value="{x:Bind ViewModel.NetFlowText, Mode=OneWay}" />
      </Grid>
      <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.NetFlowDirection, Mode=OneWay}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Rectangle Style="{StaticResource HairlineDividerStyle}" />
    <StackPanel Padding="{StaticResource SectionPadding}" Spacing="24">
      <controls:InstrumentSlider Label="SYSTEM LOAD" Minimum="0" Maximum="100" TickFrequency="10"
                                 Value="{x:Bind ViewModel.LoadSetpoint, Mode=TwoWay}"
                                 ValueText="{x:Bind ViewModel.LoadSetpointText, Mode=OneWay}" />
      <controls:InstrumentSlider Label="COMPUTE ALLOCATION" Minimum="0" Maximum="100" TickFrequency="10"
                                 Value="{x:Bind ViewModel.ComputeAllocation, Mode=TwoWay}"
                                 ValueText="{x:Bind ViewModel.ComputeAllocationText, Mode=OneWay}" />
      <controls:InstrumentToggle Label="SOLAR TRACKING" Description="Array follows the light source (+15 %)."
                                 IsOn="{x:Bind ViewModel.SolarTracking, Mode=TwoWay}" />
      <Button Style="{StaticResource LumenTextButtonStyle}" Command="{x:Bind ViewModel.ResetControlsCommand}"
              Content="Return controls to nominal" />
    </StackPanel>
  </StackPanel>
</UserControl>
