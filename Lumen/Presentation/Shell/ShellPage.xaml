<Page x:Class="Lumen.Presentation.Shell.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rive="using:Lumen.Rive"
      xmlns:controls="using:Lumen.Controls"
      xmlns:overview="using:Lumen.Presentation.Overview"
      xmlns:energy="using:Lumen.Presentation.Energy"
      xmlns:explorer="using:Lumen.Presentation.Explorer"
      xmlns:diagnostics="using:Lumen.Presentation.Diagnostics"
      xmlns:network="using:Lumen.Presentation.Network"
      Background="{StaticResource CanvasBrush}">

  <Grid x:Name="Root" Background="{StaticResource CanvasBrush}">
    <Grid x:Name="LayoutRoot">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="{StaticResource NavRailWidth}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="ContextColumn" Width="{StaticResource ContextPanelWidth}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="TopNavRow" Height="0" />
        <RowDefinition x:Name="StageRow" Height="*" />
        <RowDefinition x:Name="ConditionRow" Height="0" />
        <RowDefinition x:Name="LowerContextRow" Height="0" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: wordmark left, status right. -->
      <Grid x:Name="Header" Grid.ColumnSpan="3" Padding="32,24,32,16" Opacity="0">
        <StackPanel Spacing="6">
          <TextBlock Text="L U M E N" Style="{StaticResource WordmarkTextStyle}" />
          <TextBlock Text="A  L I V I N G  M A C H I N E" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
        <StackPanel x:Name="HeaderStatus" Orientation="Horizontal" Spacing="32" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.StateBrush, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource PrimaryTextBrush}"
                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="System state" />
          </StackPanel>
          <TextBlock x:Name="ScreenTitleText" Text="{x:Bind ViewModel.ScreenTitle, Mode=OneWay}" Style="{StaticResource QuietLabelTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" Style="{StaticResource QuietLabelTextStyle}" />
        </StackPanel>
      </Grid>

      <!-- Navigation: quiet, one selection line. -->
      <Grid x:Name="NavArea" Grid.Row="2" Opacity="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="NavItems" Padding="0,24,0,0" AutomationProperties.Name="Navigation">
          <RadioButton x:Name="NavOverview" GroupName="Nav" Style="{StaticResource NavItemStyle}" Content="OVERVIEW" Tag="Overview" Checked="OnNavChecked" IsChecked="True" />
          <RadioButton x:Name="NavEnergy" GroupName="Nav" Style="{StaticResource NavItemStyle}" Content="ENERGY FLOW" Tag="Energy" Checked="OnNavChecked" />
          <RadioButton x:Name="NavExplorer" GroupName="Nav" Style="{StaticResource NavItemStyle}" Content="SYSTEM EXPLORER" Tag="Explorer" Checked="OnNavChecked" />
          <RadioButton x:Name="NavDiagnostics" GroupName="Nav" Style="{StaticResource NavItemStyle}" Content="DIAGNOSTICS" Tag="Diagnostics" Checked="OnNavChecked" />
          <RadioButton x:Name="NavNetwork" GroupName="Nav" Style="{StaticResource NavItemStyle}" Content="NETWORK" Tag="Network" Checked="OnNavChecked" />
        </StackPanel>
        <StackPanel x:Name="Meta" Grid.Row="1" Padding="32,0,16,24" Spacing="4">
          <TextBlock Text="SYSTEM 01" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="v0.1" Style="{StaticResource CaptionTextStyle}" />
          <TextBlock Text="UNO + CORE CONTRACT" Style="{StaticResource CaptionTextStyle}" />
          <TextBlock Text="BUILT WITH .NET" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
      </Grid>

      <!-- Stage: the Core plus primary telemetry arranged around it. -->
      <Grid x:Name="Stage" Grid.Row="2" Grid.Column="1" SizeChanged="OnStageSizeChanged">
        <rive:CoreStage x:Name="Core" AutomationProperties.Name="{x:Bind ViewModel.CoreAccessibleName, Mode=OneWay}" />

        <Canvas x:Name="OrbitReadouts" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.ShowOrbitReadouts, Mode=OneWay}">
          <controls:TelemetryReadout x:Name="PowerReadout" Label="POWER" Opacity="0"
                                     Value="{x:Bind ViewModel.PowerText, Mode=OneWay}" Detail="{x:Bind ViewModel.PowerDetail, Mode=OneWay}"
                                     BarValue="{x:Bind ViewModel.PowerFraction, Mode=OneWay}" />
          <StackPanel x:Name="EnvironmentReadout" Orientation="Horizontal" Spacing="32" Opacity="0">
            <controls:TelemetryReadout Label="ENVIRONMENT" Value="{x:Bind ViewModel.EnvironmentText, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.EnvironmentDetail, Mode=OneWay}" Style="{StaticResource QuietLabelTextStyle}" LineHeight="18" VerticalAlignment="Top" />
          </StackPanel>
          <controls:TelemetryReadout x:Name="CommsReadout" Label="COMMUNICATIONS" Opacity="0"
                                     Value="{x:Bind ViewModel.LatencyText, Mode=OneWay}" Detail="{x:Bind ViewModel.CommsDetail, Mode=OneWay}"
                                     BarValue="{x:Bind ViewModel.LatencyFraction, Mode=OneWay}" />
          <StackPanel x:Name="NavigationReadout" Orientation="Horizontal" Spacing="32" Opacity="0">
            <controls:TelemetryReadout Label="NAVIGATION" Value="{x:Bind ViewModel.NavigationText, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.NavigationDetail, Mode=OneWay}" Style="{StaticResource QuietLabelTextStyle}" LineHeight="18" VerticalAlignment="Top" />
          </StackPanel>
        </Canvas>

        <!-- First-run titles and the in-place coach, annotated on the lower axis. No modal. -->
        <Canvas IsHitTestVisible="False">
          <Grid x:Name="PromptStack">
            <TextBlock x:Name="SystemTitle" Text="S Y S T E M   0 1" Style="{StaticResource PromptTextStyle}" HorizontalAlignment="Left" Opacity="0" />
            <TextBlock x:Name="InitializedText" Text="SYSTEM INITIALIZED&#x0a;6 SUBSYSTEMS ONLINE" Style="{StaticResource PromptTextStyle}"
                       HorizontalAlignment="Left" Foreground="{StaticResource SecondaryTextBrush}" LineHeight="18" Opacity="0" />
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsCoachVisible, Mode=OneWay}">
              <TextBlock Text="›" Style="{StaticResource PromptTextStyle}" Foreground="{StaticResource NominalBrush}" />
              <TextBlock x:Name="CoachText" Text="{x:Bind ViewModel.CoachPrompt, Mode=OneWay}" Style="{StaticResource PromptTextStyle}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Grid>
        </Canvas>
      </Grid>

      <!-- Compact condition line (mobile). -->
      <StackPanel x:Name="CompactCondition" Grid.Row="3" Grid.ColumnSpan="3" Padding="16,8" Spacing="4" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.StateBrush, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource PrimaryTextBrush}" />
          <TextBlock Text="{x:Bind ViewModel.HealthText, Mode=OneWay}" Style="{StaticResource QuietLabelTextStyle}" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.StateDescription, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
      </StackPanel>

      <!-- Context: right column on desktop, lower third on tablet/mobile. -->
      <ScrollViewer x:Name="ContextArea" Grid.Row="2" Grid.Column="2" Padding="0,0,32,0" Opacity="0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid>
          <overview:OverviewPanel Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}" />
          <energy:EnergyPanel Visibility="{x:Bind ViewModel.IsEnergy, Mode=OneWay}" />
          <explorer:ExplorerPanel Visibility="{x:Bind ViewModel.IsExplorer, Mode=OneWay}" />
          <diagnostics:DiagnosticsPanel Visibility="{x:Bind ViewModel.IsDiagnostics, Mode=OneWay}" />
          <network:NetworkPanel Visibility="{x:Bind ViewModel.IsNetwork, Mode=OneWay}" />
        </Grid>
      </ScrollViewer>

      <controls:StatusRail x:Name="Rail" Grid.Row="5" Grid.ColumnSpan="3" Opacity="0" />

      <Grid x:Name="Footer" Grid.Row="6" Grid.ColumnSpan="3" Padding="32,12,32,16" Opacity="0"
            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="{StaticResource HairlineTop}">
        <TextBlock Text="EXPLORE. INTERACT. UNDERSTAND." Style="{StaticResource CaptionTextStyle}" />
        <TextBlock x:Name="FooterHint" Text="CTRL+SHIFT+D  DEVELOPER VIEW   ·   ONE APPLICATION. EVERY PLATFORM." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
      </Grid>
    </Grid>

    <!-- Developer mode: who owns which pixels, and the live bindings. -->
    <Canvas x:Name="DevOverlay" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.DeveloperMode, Mode=OneWay}" />
    <Border x:Name="DevPanel" Visibility="{x:Bind ViewModel.DeveloperMode, Mode=OneWay}" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,140" Padding="16"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StructuralBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="LIVE BINDINGS · C# → CORE" Style="{StaticResource QuietLabelTextStyle}" />
        <TextBlock x:Name="DevBindings" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource SecondaryTextBrush}" LineHeight="15" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
