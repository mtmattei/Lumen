<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Text + directional affordance. No filled card; a hairline appears on hover/press. -->
  <Style x:Key="LumenTextButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="0,10,0,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="Content"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" />
            <TextBlock x:Name="Arrow" Grid.Column="1" Text="›" Margin="12,0,0,0"
                       FontFamily="{StaticResource MonoFont}" FontSize="14"
                       VerticalAlignment="Center" Foreground="{StaticResource TertiaryTextBrush}">
              <TextBlock.RenderTransform>
                <TranslateTransform x:Name="ArrowShift" />
              </TextBlock.RenderTransform>
            </TextBlock>
            <Rectangle x:Name="Underline" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom"
                       Margin="0,0,0,-10" Fill="{StaticResource StructuralBrush}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="Arrow.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="Underline.Fill" Value="{StaticResource SecondaryTextBrush}" />
                    <Setter Target="ArrowShift.X" Value="3" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="Arrow.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="Underline.Fill" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="ArrowShift.X" Value="5" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter Target="Arrow.Foreground" Value="{StaticResource DisabledTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation: one selection line, never a pill. Horizontal variant moves the line under the label. -->
  <Style x:Key="NavItemStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="24,14,16,14" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="{TemplateBinding Background}">
            <Rectangle x:Name="SelectionLine" Width="1" HorizontalAlignment="Left"
                       Fill="{StaticResource PrimaryTextBrush}" Opacity="0" />
            <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource SecondaryTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="SelectionLine.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavItemHorizontalStyle" TargetType="RadioButton" BasedOn="{StaticResource NavItemStyle}">
    <Setter Property="Padding" Value="10,12,10,12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="{TemplateBinding Background}">
            <Rectangle x:Name="SelectionLine" Height="1" VerticalAlignment="Bottom"
                       Fill="{StaticResource PrimaryTextBrush}" Opacity="0" />
            <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource SecondaryTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Content.Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    <Setter Target="SelectionLine.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource QuietLabelTextStyle}">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="HairlineDividerStyle" TargetType="Rectangle">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{StaticResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style TargetType="Slider">
    <Setter Property="TickPlacement" Value="Outside" />
    <Setter Property="IsThumbToolTipEnabled" Value="False" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StructuralBrush}" />
  </Style>
</ResourceDictionary>
