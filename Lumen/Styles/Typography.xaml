<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- One FontFamily per static file: the Skia text stack ignores FontWeight on variable fonts. -->
  <FontFamily x:Key="SansFont">ms-appx:///Assets/Fonts/Geist-Regular.ttf#Geist</FontFamily>
  <FontFamily x:Key="SansLightFont">ms-appx:///Assets/Fonts/Geist-Light.ttf#Geist Light</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/GeistMono-Regular.ttf#Geist Mono</FontFamily>
  <FontFamily x:Key="MonoLightFont">ms-appx:///Assets/Fonts/GeistMono-Light.ttf#Geist Mono Light</FontFamily>

  <!-- Type scale. Hierarchy comes from size and spacing; weight stays light/regular. -->
  <Style x:Key="WordmarkTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansLightFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="LabelTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="QuietLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
  </Style>

  <Style x:Key="ValueTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoLightFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="ValueLargeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
    <Setter Property="FontSize" Value="32" />
  </Style>

  <Style x:Key="ValueSmallTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>

  <Style x:Key="PrimaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
  </Style>

  <Style x:Key="PromptTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
