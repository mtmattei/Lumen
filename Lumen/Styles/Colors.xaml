<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Neutral tokens (LUMEN_SPEC › Visual direction). Single dark theme, plain dictionary. -->
  <Color x:Key="CanvasColor">#0B0C0C</Color>
  <Color x:Key="SurfaceColor">#111313</Color>
  <Color x:Key="ElevatedColor">#161818</Color>
  <Color x:Key="StructuralColor">#2D302E</Color>
  <Color x:Key="HairlineColor">#1F2220</Color>
  <Color x:Key="PrimaryTextColor">#F1F2EF</Color>
  <Color x:Key="SecondaryTextColor">#969A96</Color>
  <Color x:Key="TertiaryTextColor">#646864</Color>
  <Color x:Key="DisabledTextColor">#454845</Color>

  <!-- Semantic accents. Used locally; ~90% of the UI stays neutral at Nominal. -->
  <Color x:Key="NominalColor">#7FB89A</Color>
  <Color x:Key="InformationColor">#8FB4D8</Color>
  <Color x:Key="ElevatedAccentColor">#D6A55C</Color>
  <Color x:Key="CriticalColor">#D8653F</Color>
  <Color x:Key="OfflineColor">#5A5E5B</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
  <SolidColorBrush x:Key="StructuralBrush" Color="{StaticResource StructuralColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

  <SolidColorBrush x:Key="NominalBrush" Color="{StaticResource NominalColor}" />
  <SolidColorBrush x:Key="InformationBrush" Color="{StaticResource InformationColor}" />
  <SolidColorBrush x:Key="ElevatedAccentBrush" Color="{StaticResource ElevatedAccentColor}" />
  <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
  <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource OfflineColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- Fluent lightweight-styling overrides so stock controls sit on the neutral palette. -->
  <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource StructuralColor}" />
  <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource StructuralColor}" />
  <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource StructuralColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SliderTickBarFill" Color="{StaticResource TertiaryTextColor}" />

  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource NominalColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource NominalColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource NominalColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource TertiaryTextColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="{StaticResource TertiaryTextColor}" />
</ResourceDictionary>
