<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 4px spacing scale: 4, 8, 12, 16, 24, 32, 48, 64, 96. -->
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space32">32</x:Double>
  <x:Double x:Key="Space48">48</x:Double>

  <Thickness x:Key="PagePadding">32,24,32,0</Thickness>
  <Thickness x:Key="SectionPadding">0,24,0,24</Thickness>
  <Thickness x:Key="HairlineTop">0,1,0,0</Thickness>
  <Thickness x:Key="HairlineBottom">0,0,0,1</Thickness>
  <Thickness x:Key="HairlineLeft">1,0,0,0</Thickness>
  <Thickness x:Key="HairlineRight">0,0,1,0</Thickness>

  <x:Double x:Key="NavRailWidth">200</x:Double>
  <x:Double x:Key="ContextPanelWidth">336</x:Double>
</ResourceDictionary>
